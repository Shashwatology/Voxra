{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    { "source": "/ask", "destination": "/api/index.py" },
    { "source": "/health", "destination": "/api/index.py" },
    { "source": "/faq", "destination": "/api/index.py" },
    { "source": "/metrics/summary", "destination": "/api/index.py" },
    { "source": "/evaluation/results", "destination": "/api/index.py" },
    { "source": "/handoffs/(.*)", "destination": "/api/index.py" },
    { "source": "/handoffs", "destination": "/api/index.py" },
    { "source": "/docs", "destination": "/api/index.py" },
    { "source": "/openapi.json", "destination": "/api/index.py" },
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
