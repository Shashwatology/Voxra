# Guarded Enquiry Service (Enquiry Studio / Northstar Admissions)
# Environment Configuration Template

# Operational Mode: 'hybrid' (uses Gemini for candidate selection) or 'local_only' (100% air-gapped TF-IDF)
AI_MODE=local_only

# Google Gemini API Key (Required only if AI_MODE=hybrid)
GEMINI_API_KEY=

# Configurable Gemini Model Identifier
GEMINI_MODEL=gemini-2.5-flash

# Environment: 'development' or 'production'
ENVIRONMENT=development

# Administrative Security Key for /handoffs inspection
ADMIN_API_KEY=northstar-admin-secret-dev

# Rate Limiting (Requests per minute per client IP)
RATE_LIMIT_PER_MINUTE=60

# Retrieval Tuning Thresholds
SIMILARITY_THRESHOLD=0.32
AMBIGUITY_DELTA=0.08
HIGH_CONFIDENCE_THRESHOLD=0.72

